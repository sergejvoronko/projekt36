---
// CookieConsent.astro — fonts are now self-hosted; no third-party font requests
// Retained as placeholder for future analytics consent (e.g. Cloudflare Web Analytics)
---

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 9999;
    background: var(--bg2);
    border-top: 1px solid var(--border-mid);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  .cookie-banner--visible { transform: translateY(0); }
  .cookie-banner--hidden  { transform: translateY(100%); }

  .cookie-inner {
    max-width: var(--wide-w);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cookie-text { flex: 1; min-width: 0; }
  .cookie-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.3rem;
  }
  .cookie-text p {
    font-size: 0.82rem;
    color: var(--text-mid);
    line-height: 1.65;
    margin: 0;
  }
  .cookie-link {
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-left: 0.35rem;
    white-space: nowrap;
  }
  .cookie-link:hover { text-decoration: underline; }

  .cookie-actions {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .cookie-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--border-mid);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .cookie-btn-accept {
    background: var(--accent);
    border-color: var(--accent);
    color: #131720;
    font-weight: 600;
  }
  .cookie-btn-accept:hover { background: var(--accent2); border-color: var(--accent2); }
  .cookie-btn-decline {
    background: transparent;
    color: var(--text-mid);
  }
  .cookie-btn-decline:hover { border-color: var(--text-mid); color: var(--text); }

  @media (max-width: 560px) {
    .cookie-inner { gap: 1rem; }
    .cookie-actions { width: 100%; }
    .cookie-btn { flex: 1; text-align: center; }
  }
</style>
